<% layout("layouts/boilerplate") %>

<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  .filter.active{
    opacity: 1;
    border-bottom: 2px solid black;
  }
  .filter p{
    font-size: 0.8rem;
  }
  .tax-info{
    display: none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin-left: 5rem;
    display: flex;
    align-items: center;
    margin-top: 1rem;
  }

  /* Favorite heart icon */
  .listing-card-wrap{
    position: relative;
  }
  .favorite-heart{
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 5;
    background: rgba(0,0,0,0.35);
    border: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .favorite-heart i{
    color: #fff;
    font-size: 1.05rem;
  }
  .favorite-heart.favorited i{
    color: #fe424d;
    font-weight: 900;
  }
  .guests-hint{
    color: #6c757d;
    font-size: 0.85rem;
  }
</style>

  <div id="filters">
    <div class="filter <%= category === 'Trending' ? 'active' : '' %>" data-category="Trending">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter <%= category === 'Rooms' ? 'active' : '' %>" data-category="Rooms">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
        <div class="filter <%= category === 'Iconic Cities' ? 'active' : '' %>" data-category="Iconic Cities">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div class="filter <%= category === 'Mountains' ? 'active' : '' %>" data-category="Mountains">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </div>
      <div class="filter <%= category === 'Castles' ? 'active' : '' %>" data-category="Castles">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </div>
    <div class="filter <%= category === 'Amazing pools' ? 'active' : '' %>" data-category="Amazing pools">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>
        <div class="filter <%= category === 'Camping' ? 'active' : '' %>" data-category="Camping">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
      <div class="filter <%= category === 'Farms' ? 'active' : '' %>" data-category="Farms">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter <%= category === 'Arctic' ? 'active' : '' %>" data-category="Arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
          <div class="filter <%= category === 'Beachs' ? 'active' : '' %>" data-category="Beachs">
      <div><i class="fa-solid fa-umbrella-beach"></i></div>
      <p>Beachs</p>
    </div>
    <div class="filter <%= category === 'Domes' ? 'active' : '' %>" data-category="Domes">
      <div><i class="fa-solid fa-landmark-dome"></i></div>
      <p>Domes</p>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
    </div>
  </div>

  <% if(category){ %>
    <div class="mt-2">
      <a href="/listings" class="btn btn-sm btn-outline-dark">Clear filter: <%= category %> &times;</a>
    </div>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){ %>
      <div class="col">
        <div class="listing-card-wrap">
          <button class="favorite-heart <%= favoriteIds && favoriteIds.includes(listing._id.toString()) ? 'favorited' : '' %>"
                  data-listing-id="<%= listing._id %>" aria-label="Toggle favorite">
            <i class="fa-solid fa-heart"></i>
          </button>
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card">
              <img src="<%= listing.image.url %>"
                   class="card-img-top"
                   alt="listing_image"
                   style="width: 20rem; height: 20rem;" />
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b> <br>
                  &#8377 <%= listing.price.toLocaleString("en-IN") %>/night
                  <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                  <br>
                  <span class="guests-hint">Up to <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) > 1 ? "s" : "" %></span>
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () =>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      }else{
        info.style.display = "none";
      }
    }
  })

  let filterIcons = document.querySelectorAll(".filter[data-category]");
  filterIcons.forEach((el) => {
    el.addEventListener("click", () => {
      let category = el.getAttribute("data-category");
      if(el.classList.contains("active")){
        window.location.href = "/listings";
      } else {
        window.location.href = "/listings?category=" + encodeURIComponent(category);
      }
    });
  });

  // Favorite heart toggle
  document.querySelectorAll(".favorite-heart").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const listingId = btn.getAttribute("data-listing-id");
      try{
        const res = await fetch(`/listings/${listingId}/favorite`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });

        if(res.redirected || res.status === 401 || res.status === 403){
          window.location.href = "/login";
          return;
        }

        const data = await res.json();
        btn.classList.toggle("favorited", data.favorited);
      } catch(err){
        console.error("Failed to toggle favorite:", err);
      }
    });
  });
</script>