<% layout("layouts/boilerplate") %>

<body>
    <div class="row mt-3">
        <div class="col-12 col-md-8 offset-md-2">
        <h3><%= listing.title %></h3>
       </div>
    <div class="card col-12 col-md-6 offset-md-3">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
            <div class="d-flex align-items-center mb-2">
              <% if(listing.owner){ %>
                <img src="<%= listing.owner.avatarUrl %>" alt="host"
                     style="width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; margin-right: 0.6rem;">
              <% } %>
              <b><i>@<%= listing.owner ? listing.owner.username : "Unknown host" %></i></b>
            </div>
            <%= listing.description %> <br>
            &#8377;<%= listing.price.toLocaleString("en-IN") %> <br>
            <%= listing.location %> <br>
            <%= listing.country %> <br>
            <span class="text-muted">Up to <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) > 1 ? "s" : "" %></span>
        </p>
        </div>
    </div>
    <% if(currUser){ %>
      <div class="col-12 col-md-6 offset-md-3 mt-2 mb-4">
        <button id="show-favorite-heart"
                class="btn btn-outline-danger btn-sm <%= currUser.favorites && currUser.favorites.map(id => id.toString()).includes(listing._id.toString()) ? 'active' : '' %>"
                data-listing-id="<%= listing._id %>">
          <i class="fa-solid fa-heart"></i>
          <span class="favorite-label"><%= currUser.favorites && currUser.favorites.map(id => id.toString()).includes(listing._id.toString()) ? "Saved to favorites" : "Save to favorites" %></span>
        </button>
      </div>
    <% } %>
    <br>
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){  %>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger col-auto ms-md-3">Edit</a>
        <br>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
        <button class="btn btn-dark ms-md-3">Delete</button>
    </form>
    </div>
 </div>
  <% } %>
 <div class="col-12 col-md-8 offset-md-2 mb-3">
    <hr> 
      <% if(currUser){  %>
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
         <!-- <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" min="1" max="5" name="review[rating]" class="form-range">
         </div> -->
         <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
         <fieldset class="starability-basic">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
         </fieldset>
         </div>
         <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comment</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">Please add sum comments for review</div>
        </div>
         <br>
         <button class="btn btn-outline-dark">Submit</button>
    </form>
    <% } %>
    <br>
    <% if(listing.reviews.length > 0) { %>
    <ul>
      <h5>All Reviews</h5>
      <% for(review of listing.reviews) { %>
        <div style="
        min-width: 20rem; 
        width: fit-content;
        min-height: 10rem;
        height: fit-content;
        border: 1px solid black;
        list-style: none;
        margin-top: 2rem;
        padding: 1rem;
        border-radius: 1rem;">
        <li>
          <div class="d-flex align-items-center mb-1">
            <% if(review.author){ %>
              <img src="<%= review.author.avatarUrl %>" alt="reviewer"
                   style="width: 2rem; height: 2rem; border-radius: 50%; object-fit: cover; margin-right: 0.5rem;">
            <% } %>
            <b>@<%= review.author ? review.author.username : "Unknown user" %></b>
          </div>
          <br> 
          <p class="starability-result" data-rating="<%= review.rating %>"></p>
          <%= review.comment %>
        </li>
        <br>
        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm btn-dark">Delete</button>
        </form> 
      </div>
    <% } %>
   </ul>
  <% } %>
 </div>
 <div class="card col-12 col-md-6 offset-md-3">
  <h3>Where you'll be</h3>
  <div id="map"></div>
</div>

<style>
  #map {
    width: 100%;
    height: 300px;
    border-radius: 8px;
    margin-top: 1rem;
  }
  #map-message {
    margin-top: 1rem;
    color: #6c757d;
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Use the structured location/country fields (not the free-text title)
    // for geocoding — this is far more reliable with Nominatim.
    const searchQuery = "<%= listing.location %>, <%= listing.country %>";
    const mapDiv = document.getElementById("map");

    fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(searchQuery)}`, {
      headers: { "Accept-Language": "en" }
    })
      .then(res => {
        if(!res.ok){
          throw new Error(`Nominatim request failed with status ${res.status}`);
        }
        return res.json();
      })
      .then(data => {
        if (data.length > 0) {
          const lat = parseFloat(data[0].lat);
          const lng = parseFloat(data[0].lon);

          const map = L.map('map').setView([lat, lng], 11);

          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
          }).addTo(map);

          L.marker([lat, lng])
            .addTo(map)
            .bindPopup(`<strong><%= listing.location %>, <%= listing.country %></strong>`)
            .openPopup();
        } else {
          mapDiv.insertAdjacentHTML("afterend", `<p id="map-message">Exact location for "${searchQuery}" couldn't be found on the map.</p>`);
          mapDiv.style.display = "none";
        }
      })
      .catch(err => {
        console.error("Geocoding error:", err);
        mapDiv.insertAdjacentHTML("afterend", `<p id="map-message">Map is temporarily unavailable. Please try again later.</p>`);
        mapDiv.style.display = "none";
      });
  });
</script>

<script>
  const favBtn = document.getElementById("show-favorite-heart");
  if(favBtn){
    favBtn.addEventListener("click", async () => {
      const listingId = favBtn.getAttribute("data-listing-id");
      try{
        const res = await fetch(`/listings/${listingId}/favorite`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });

        if(res.redirected || res.status === 401 || res.status === 403){
          window.location.href = "/login";
          return;
        }

        const data = await res.json();
        favBtn.classList.toggle("active", data.favorited);
        favBtn.querySelector(".favorite-label").textContent = data.favorited ? "Saved to favorites" : "Save to favorites";
      } catch(err){
        console.error("Failed to toggle favorite:", err);
      }
    });
  }
</script>

</body>