<% layout("layouts/boilerplate") %>

<style>
  .listing-card-wrap{
    position: relative;
  }
  .favorite-heart{
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 5;
    background: rgba(0,0,0,0.35);
    border: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .favorite-heart i{
    color: #fff;
    font-size: 1.05rem;
  }
  .favorite-heart.favorited i{
    color: #fe424d;
    font-weight: 900;
  }
  .guests-hint{
    color: #6c757d;
    font-size: 0.85rem;
  }
</style>

<h3 class="mt-3">My Favorites</h3>

<% if(allListings.length === 0){ %>
  <p class="text-muted mt-3">You haven't favorited any listings yet. Tap the heart icon on a listing to save it here.</p>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings){ %>
    <div class="col">
      <div class="listing-card-wrap">
        <button class="favorite-heart favorited" data-listing-id="<%= listing._id %>" aria-label="Toggle favorite">
          <i class="fa-solid fa-heart"></i>
        </button>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card">
            <img src="<%= listing.image.url %>"
                 class="card-img-top"
                 alt="listing_image"
                 style="width: 20rem; height: 20rem;" />
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b> <br>
                &#8377 <%= listing.price.toLocaleString("en-IN") %>/night
                <br>
                <span class="guests-hint">Up to <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) > 1 ? "s" : "" %></span>
              </p>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.querySelectorAll(".favorite-heart").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const listingId = btn.getAttribute("data-listing-id");
      try{
        const res = await fetch(`/listings/${listingId}/favorite`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });

        if(res.redirected || res.status === 401 || res.status === 403){
          window.location.href = "/login";
          return;
        }

        const data = await res.json();
        if(!data.favorited){
          // Removed from favorites — remove the card from this page immediately
          btn.closest(".col").remove();
        }
      } catch(err){
        console.error("Failed to toggle favorite:", err);
      }
    });
  });
</script>