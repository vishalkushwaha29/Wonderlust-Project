<% layout("layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="text-center">My Profile</h1>
        <div class="col-12 col-md-6 offset-md-3 text-center">
            <img src="<%= currUser.avatarUrl %>" alt="profile picture"
                 style="width: 10rem; height: 10rem; border-radius: 50%; object-fit: cover; margin-bottom: 1rem;">

            <h4>@<%= currUser.username %></h4>
            <p class="text-muted"><%= currUser.email %></p>

            <form action="/profile" method="POST" enctype="multipart/form-data" class="mt-3">
                <div class="mb-3">
                    <label for="avatar" class="form-label">Upload new profile picture</label>
                    <input name="avatar" id="avatar" type="file" class="form-control" accept="image/*">
                </div>
                <button class="btn btn-dark">Save Photo</button>
            </form>
        </div>
    </div>