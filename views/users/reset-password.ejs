<% layout("layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="col-6 offset-5">Reset Password</h1>
        <div class="col-6 offset-3">
            <p>Enter the code sent to <b><%= email %></b> along with your new password.</p>
            <form action="/reset-password" method="POST" class="needs-validation" novalidate>
                <input type="hidden" name="email" value="<%= email %>">
                <div class="mb-3">
                  <label for="otp" class="form-label">Verification code</label>
                    <input
                        name="otp"
                        id="otp"
                        type="text"
                        maxlength="6"
                        pattern="[0-9]{6}"
                        class="form-control"
                        placeholder="123456"
                        required
                    >
                </div>
                <div class="mb-3">
                  <label for="newPassword" class="form-label">New Password</label>
                    <input
                        name="newPassword"
                        id="newPassword"
                        type="password"
                        class="form-control"
                        required
                        minlength="6"
                    >
                </div>
                <div class="mb-3">
                  <label for="confirmPassword" class="form-label">Confirm New Password</label>
                    <input
                        name="confirmPassword"
                        id="confirmPassword"
                        type="password"
                        class="form-control"
                        required
                        minlength="6"
                    >
                </div>
                <button class="btn btn-success">Reset Password</button>
            </form>
            <br>
            <a href="/resend-otp?email=<%= encodeURIComponent(email) %>&purpose=reset">Didn't get a code? Resend it</a>
        </div>
    </div>