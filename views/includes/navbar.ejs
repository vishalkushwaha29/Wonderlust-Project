<style>
  .btn-search{
    background-color: #fe424d;
    color: #fff;
    border-radius: 1.6rem;
    padding: 0 1rem 0 1rem;
  }
  .btn-search:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .btn-search i{
    display: inline;
    margin-right: 0.5rem;
  }
  .search-inp{
    border-radius: 1.6rem;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
    min-width: 0;
    flex: 1 1 auto;
  }
  @media (max-width: 576px){
    .search-inp{
      padding: 0.5rem 1rem 0.5rem 1rem;
    }
    .btn-search span{
      display: none; /* icon-only search button on very small screens */
    }
  }

  /* Turn the mobile nav collapse into a left-side slide-in panel */
  @media (max-width: 767.98px){
    #navbarNavAltMarkup{
      position: fixed !important;
      top: 0;
      left: -85%;
      width: 80%;
      max-width: 300px;
      height: 100% !important;
      background-color: var(--bs-body-bg);
      box-shadow: 2px 0 10px rgba(0,0,0,0.25);
      z-index: 1045;
      transition: left 0.3s ease-in-out;
      padding: 4.5rem 1.25rem 1.5rem;
      overflow-y: auto;
      display: flex !important;
      flex-direction: column;
      align-items: flex-start !important;
    }
    #navbarNavAltMarkup.show{
      left: 0;
    }
    #navbarNavAltMarkup .navbar-nav{
      width: 100%;
      margin-bottom: 0;
    }
    #navbarNavAltMarkup .navbar-nav.ms-auto{
      margin-left: 0 !important;
    }
    /* Each link becomes a full-width row: icon + label, with a separator,
       matching the profile drawer's look for a consistent design. */
    #navbarNavAltMarkup .nav-link{
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      padding: 0.85rem 0;
      border-bottom: 1px solid rgba(128,128,128,0.2);
    }
    #navbarNavAltMarkup form.d-flex{
      width: 100%;
      margin: 1rem 0;
    }
    #navbarNavAltMarkup .mobile-profile-row{
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      padding: 0.85rem 0;
    }
    #navbarNavAltMarkup .profile-btn{
      flex-shrink: 0;
    }
    .mobile-nav-title{
      font-weight: 700;
      font-size: 1.3rem;
      color: #fe424d;
      padding-bottom: 1rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid rgba(128,128,128,0.2);
      width: 100%;
    }
    #mobile-nav-backdrop{
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background-color: rgba(0,0,0,0.4);
      z-index: 1040;
    }
    #mobile-nav-backdrop.show{
      display: block;
    }
  }

  /* Profile icon */
  .profile-btn{
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background-color: #fe424d;
    color: #fff;
    border: none;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    overflow: hidden;
  }
  .profile-btn img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile-btn:hover{
    opacity: 0.9;
  }

  /* Slide-in drawer */
  #profile-drawer{
    position: fixed;
    top: 0;
    right: -100%;
    width: min(300px, 90vw);
    height: 100%;
    background-color: var(--bs-body-bg);
    box-shadow: -2px 0 10px rgba(0,0,0,0.2);
    z-index: 1050;
    transition: right 0.3s ease-in-out;
    padding: 1.5rem;
  }
  #profile-drawer.open{
    right: 0;
  }
  #drawer-backdrop{
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: rgba(0,0,0,0.4);
    z-index: 1040;
  }
  #drawer-backdrop.open{
    display: block;
  }
  .drawer-header{
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  #drawer-close{
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
  .drawer-link{
    display: block;
    padding: 0.75rem 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(128,128,128,0.2);
  }
  .drawer-link:hover{
    color: #fe424d;
  }
  .theme-toggle-row{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(128,128,128,0.2);
  }
</style>

<div id="drawer-backdrop"></div>
<div id="profile-drawer">
  <div class="drawer-header">
    <button id="drawer-close" class="btn-close" aria-label="Close"></button>
    <div class="d-flex align-items-center">
      <% if(typeof currUser !== "undefined" && currUser){ %>
        <img src="<%= currUser.avatarUrl %>" alt="avatar" style="width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; margin-right: 0.75rem;">
        <div>
          <h5 class="mb-0">@<%= currUser.username %></h5>
          <small class="text-muted"><%= currUser.email %></small>
        </div>
      <% } else { %>
        <h5 class="mb-0">Welcome to Wanderlust</h5>
      <% } %>
    </div>
  </div>

  <% if(typeof currUser !== "undefined" && currUser){ %>
    <a href="/profile" class="drawer-link"><i class="fa-solid fa-circle-user"></i>&nbsp; My Profile</a>
    <a href="/listings/new" class="drawer-link"><i class="fa-solid fa-house"></i>&nbsp; Airbnb your home</a>
    <a href="/change-password" class="drawer-link"><i class="fa-solid fa-key"></i>&nbsp; Change Password</a>
  <% } else { %>
    <a href="/signup" class="drawer-link"><i class="fa-solid fa-user-plus"></i>&nbsp; Sign up</a>
    <a href="/login" class="drawer-link"><i class="fa-solid fa-right-to-bracket"></i>&nbsp; Log in</a>
  <% } %>

  <div class="theme-toggle-row">
    <span><i class="fa-solid fa-moon"></i>&nbsp; Dark Theme</span>
    <div class="form-check form-switch mb-0">
      <input class="form-check-input theme-toggle-checkbox" type="checkbox" role="switch" id="dark-theme-toggle">
    </div>
  </div>

  <% if(typeof currUser !== "undefined" && currUser){ %>
    <a href="/listings/favorites/mine" class="drawer-link"><i class="fa-solid fa-heart"></i>&nbsp; Favorites</a>
    <a href="/logout" class="drawer-link"><i class="fa-solid fa-right-from-bracket"></i>&nbsp; Log out</a>
  <% } %>
</div>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand d-flex align-items-center" href="/listings">
      <i class="fa-regular fa-compass me-2"></i>
      <span class="wanderlust-brand-text">Wanderlust</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div id="mobile-nav-backdrop"></div>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="d-md-none mobile-nav-title">Wanderlust</div>

      <!-- Mobile-only: Profile (if logged in) or Sign up / Log in (if not) -->
      <div class="navbar-nav d-md-none w-100">
        <% if(typeof currUser !== "undefined" && currUser){ %>
          <div class="mobile-profile-row">
            <button id="profile-btn-mobile" class="profile-btn" type="button" aria-label="Profile menu">
              <img src="<%= currUser.avatarUrl %>" alt="profile">
            </button>
            <span>@<%= currUser.username %></span>
          </div>
        <% } else { %>
          <a class="nav-link" href="/signup"><i class="fa-solid fa-user-plus"></i>Sign up</a>
          <a class="nav-link" href="/login"><i class="fa-solid fa-right-to-bracket"></i>Log in</a>
        <% } %>
      </div>

      <div class="navbar-nav">
        <a class="nav-link" href="/listings"><i class="fa-solid fa-compass d-md-none"></i>Explore</a>
      </div>

      <!-- Desktop-only: Home icon + search bar -->
      <div class="navbar-nav ms-auto align-items-center d-none d-md-flex">
        <a href="/listings" class="nav-link me-2" title="Home"><i class="fa-solid fa-house"></i></a>
        <form class="d-flex" role="search" action="/listings" method="GET">
        <input class="form-control me-2 search-inp" type="search" name="destination" placeholder="Search destination  "/>
        <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></button>
        </form>
      </div>

      <!-- Desktop-only: profile icon (always visible, even logged out, so theme toggle stays reachable) -->
      <div class="navbar-nav ms-auto d-none d-md-flex">
        <button id="profile-btn" class="profile-btn" type="button" aria-label="Profile menu">
          <% if(typeof currUser !== "undefined" && currUser){ %>
            <img src="<%= currUser.avatarUrl %>" alt="profile">
          <% } else { %>
            <i class="fa-solid fa-user"></i>
          <% } %>
        </button>
      </div>

      <div class="navbar-nav d-md-none w-100">
        <div class="theme-toggle-row">
          <span><i class="fa-solid fa-moon"></i>&nbsp; Dark Theme</span>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input theme-toggle-checkbox" type="checkbox" role="switch" id="dark-theme-toggle-mobile">
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const profileTriggers = document.querySelectorAll("#profile-btn, #profile-btn-mobile");
  const drawer = document.getElementById("profile-drawer");
  const backdrop = document.getElementById("drawer-backdrop");
  const drawerClose = document.getElementById("drawer-close");
  const themeToggles = document.querySelectorAll(".theme-toggle-checkbox");

  function openDrawer(){
    drawer.classList.add("open");
    backdrop.classList.add("open");
  }
  function closeDrawer(){
    drawer.classList.remove("open");
    backdrop.classList.remove("open");
  }

  profileTriggers.forEach((btn) => {
    btn.addEventListener("click", openDrawer);
  });
  drawerClose.addEventListener("click", closeDrawer);
  backdrop.addEventListener("click", closeDrawer);

  // Dark theme: read saved preference and reflect it across every toggle
  // (there can be more than one — profile drawer and mobile nav panel).
  const savedTheme = localStorage.getItem("theme") || "light";
  document.documentElement.setAttribute("data-bs-theme", savedTheme);
  themeToggles.forEach((toggle) => {
    toggle.checked = savedTheme === "dark";
    toggle.addEventListener("change", () => {
      const newTheme = toggle.checked ? "dark" : "light";
      document.documentElement.setAttribute("data-bs-theme", newTheme);
      localStorage.setItem("theme", newTheme);
      // Keep every toggle on the page in sync with each other.
      themeToggles.forEach((t) => { t.checked = toggle.checked; });
    });
  });

  // Mobile side-nav backdrop: show while the collapse menu is open,
  // and tapping it closes the menu (using Bootstrap's own Collapse API).
  const mobileNav = document.getElementById("navbarNavAltMarkup");
  const mobileNavBackdrop = document.getElementById("mobile-nav-backdrop");
  if(mobileNav && mobileNavBackdrop){
    mobileNav.addEventListener("show.bs.collapse", () => {
      mobileNavBackdrop.classList.add("show");
    });
    mobileNav.addEventListener("hide.bs.collapse", () => {
      mobileNavBackdrop.classList.remove("show");
    });
    mobileNavBackdrop.addEventListener("click", () => {
      const collapseInstance = bootstrap.Collapse.getOrCreateInstance(mobileNav);
      collapseInstance.hide();
    });
  }
</script>